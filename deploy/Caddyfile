# Reverse proxy dengan TLS otomatis (Let's Encrypt) via Caddy.
# Variabel DOMAIN dibaca dari environment container.

{$DOMAIN} {
	encode gzip

	# API & dokumen lokal → backend
	handle /api/* {
		reverse_proxy backend:8000
	}

	# SPA frontend (nginx statis)
	handle {
		reverse_proxy frontend:80
	}
}

# Object storage (MinIO) untuk link unduhan bertanda tangan: CV, dokumen,
# kontrak, selfie absensi, rekaman AI Interview. Header Host diteruskan apa
# adanya (default reverse_proxy) sehingga tanda tangan S3 yang dibuat
# backend untuk files.{$DOMAIN} tetap valid. Butuh DNS record
# files.<DOMAIN> -> server ini. Isi bucket TETAP privat: tanpa URL
# bertanda tangan yang masih berlaku, objek tidak bisa dibaca.
files.{$DOMAIN} {
	reverse_proxy minio:9000
}

# Interview suara AI (profile "voice"): sinyal LiveKit untuk browser kandidat
# (wss://). Media WebRTC TIDAK lewat sini -- langsung ke port UDP/TCP server.
# Butuh DNS record livekit.<DOMAIN> -> server ini. Bila profile voice tidak
# dijalankan, host ini hanya membalas 502 (situs utama tidak terpengaruh).
livekit.{$DOMAIN} {
	reverse_proxy livekit:7880
}
