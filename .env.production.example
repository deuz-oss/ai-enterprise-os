# ============================================================
# TEMPLATE ENV PRODUKSI — salin ke .env.production lalu isi.
# Semua nilai bertanda WAJIB harus diisi sebelum deploy.
# ============================================================

# ---- Domain & TLS (Caddy) ----
# Domain publik yang mengarah (A/AAAA record) ke server ini.
DOMAIN=aeos.example.com

# ---- Application ----
APP_ENV=production
# WAJIB: generate dengan  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Origin yang diizinkan (tanpa trailing slash). Samakan dengan DOMAIN.
CORS_ORIGINS=https://aeos.example.com
# Jumlah worker uvicorn (2-4 cukup untuk mulai)
UVICORN_WORKERS=2

# ---- Admin tenant default (dibuat saat start pertama) ----
ADMIN_EMAIL=admin@perusahaan-anda.co.id
ADMIN_PASSWORD=

# ---- Platform admin multi-tenant ----
PLATFORM_ADMIN_EMAIL=platform@perusahaan-anda.co.id
# Kosong = tidak dibuat. Isi minimal 8 karakter untuk mengaktifkan.
PLATFORM_ADMIN_PASSWORD=

# ---- PostgreSQL (internal compose; tidak diekspos ke publik) ----
POSTGRES_DB=aeos
# Role PEMILIK skema — hanya dipakai service migrasi (alembic)
POSTGRES_USER=aeos
POSTGRES_PASSWORD=

# Role RUNTIME aplikasi (bukan pemilik) agar Row Level Security efektif.
# Dibuat otomatis oleh deploy/pg/init-roles.sh saat inisialisasi volume pertama.
APP_DB_USER=aeos_app
APP_DB_PASSWORD=

# ---- Object storage MinIO (internal compose) ----
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=documents

# ---- AI Layer (opsional) ----
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Tanda tangan elektronik (opsional) ----
ESIGN_PROVIDER=
PRIVY_API_URL=https://sign.privy.id/api/v1
PRIVY_MERCHANT_KEY=
PRIVY_USERNAME=
PRIVY_PASSWORD=
ESIGN_WEBHOOK_SECRET=
