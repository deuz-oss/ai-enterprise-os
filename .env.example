# ---- Application ----
PROJECT_NAME="AI Enterprise OS"
APP_ENV=dev
# WAJIB diganti: generate dengan  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-64-char-hex
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Akun admin yang dibuat otomatis saat pertama kali start
# (admin tenant "default"; platform admin mengelola daftar tenant SaaS)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Akun pengelola platform multi-tenant (role platform_admin, tanpa tenant)
PLATFORM_ADMIN_EMAIL=platform@example.com
# Kosong = tidak dibuat otomatis (isi minimal 8 karakter untuk mengaktifkan)
PLATFORM_ADMIN_PASSWORD=

# ---- Mode lokal (tanpa Docker) ----
# Semua data tersimpan di folder ./data : SQLite + dokumen upload.
DATA_DIR=./data

# ---- AI Layer (opsional) ----
# API kompatibel OpenAI. Contoh:
#   OpenAI  : https://api.openai.com/v1
#   Ollama  : http://localhost:11434/v1
#   vLLM    : http://localhost:8000/v1
# Kosong => fitur AI (screening CV, matching, RAG) nonaktif.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Model embedding untuk RAG Q&A dokumen kontrak.
# Ollama contoh: nomic-embed-text
AI_EMBEDDING_MODEL=text-embedding-3-small

# ---- AI Interview Fase 2: percakapan suara real-time (opsional) ----
# LLM/reasoning TETAP lewat AI_BASE_URL di atas. STT self-hosted
# (faster-whisper). TTS JUGA lewat AI_BASE_URL/AI_API_KEY (OpenAI) --
# facebook/mms-tts-ind self-hosted dicoba lebih dulu tapi kualitas
# suaranya jelek, lihat agent/main.py. Kosong => endpoint /voice/start
# 503. Jalankan `docker compose --profile voice up` untuk service
# pendukungnya (livekit, stt-server, ai-interview-agent).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STT_BASE_URL=
# Opsional -- default gpt-4o-mini-tts / ash kalau kosong.
AI_TTS_MODEL=
AI_TTS_VOICE=

# ---- Tanda Tangan Elektronik (opsional) ----
# ESIGN_PROVIDER kosong => fitur nonaktif.
#   sandbox : simulasi lokal tanpa vendor (untuk dev/demo)
#   privy   : PrivyID (isi kredensial di bawah)
ESIGN_PROVIDER=
PRIVY_API_URL=https://sign.privy.id/api/v1
PRIVY_MERCHANT_KEY=
PRIVY_USERNAME=
PRIVY_PASSWORD=
# Rahasia bersama untuk memverifikasi header webhook penyedia TTE
ESIGN_WEBHOOK_SECRET=

# ---- Mode Operasi (PRD v2.0) ----
# internal = semua bundle aktif tanpa cek lisensi (fase internal sekarang)
# commercial = lisensi per bundle (Starter/Growth/Scale/Enterprise)
APP_MODE=internal

# ---- Email Notifikasi (opsional) ----
# SMTP_HOST kosong => notifikasi hanya in-app (tanpa email).
# Contoh: smtp.gmail.com :587 / layanan seperti Resend SMTP, Mailgun, dsb.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- e-Faktur DJP — Finance (PRD v2.0) ----
# EFAKTUR_PROVIDER kosong => mode simulasi (draft PDF lokal, tanpa hit DJP).
#   djponline | sandbox (simulasi DJP)
EFAKTUR_PROVIDER=
EFAKTUR_API_URL=https://api.efaktur.pajak.go.id
EFAKTUR_API_KEY=
EFAKTUR_NPKP=
EFAKTUR_RETRY_MAX=3

# ============================================================
# Bagian bawah hanya dipakai jika menjalankan Docker Compose.
# Untuk mode lokal, biarkan DATABASE_URL & STORAGE_ENDPOINT kosong.
# ============================================================

POSTGRES_DB=aeos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Role aplikasi terpisah dari pemilik skema (POSTGRES_USER di atas) --
# WAJIB, bukan opsional: role pemilik tabel (dan superuser) selalu melewati
# Postgres Row Level Security, jadi kalau backend connect pakai POSTGRES_USER
# langsung, RLS yang didefinisikan di migrasi (lihat alembic/versions/*rls*)
# tidak berlaku sama sekali walau kebijakannya sudah dibuat. Role ini dibuat
# otomatis oleh deploy/pg/init-roles.sh saat volume Postgres pertama kali
# di-init. Isi password sebelum `docker compose up` pertama kali.
APP_DB_USER=aeos_app
APP_DB_PASSWORD=

# Kredensial MinIO (dipakai container minio dan backend)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin-change-me
STORAGE_BUCKET=documents

# Frontend build arg saat docker compose build
VITE_API_URL=http://localhost:8000/api/v1
